{
  "name": "drift",
  "productName": "Drift",
  "version": "0.1.0",
  "description": "Lekka przeglądarka w stylu Arc: vertical tabs, workspaces, Essentials",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "import:arc": "electron-vite build && electron . --import-arc",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && svelte-check --tsconfig tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --mac --dir"
  },
  "build": {
    "appId": "com.teceer.drift",
    "productName": "Drift",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir"
    },
    "files": [
      "out/**/*"
    ]
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^22.20.4",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9",
    "vite": "^7.3.6"
  }
}
